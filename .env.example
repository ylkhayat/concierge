# Copy to .env and fill in. .env is git-ignored; never commit tokens.

# The folder that holds your clones (one parent for all repos you want reviewed). Mounted at the same path.
CODE_DIR=/Users/you/code

# Your user and group id, so files agents write in your repos stay yours. `id -u` and `id -g`.
HOST_UID=501
HOST_GID=20

# GitHub: a token with repo scope. `gh auth token` prints the one you already use.
GITHUB_TOKEN=

# Claude Code: a long-lived OAuth token from `claude setup-token` (uses your subscription) …
CLAUDE_CODE_OAUTH_TOKEN=
# … or instead an API key (billed per token): uncomment and leave the line above empty. Never set both.
# ANTHROPIC_API_KEY=

# Optional: who the agents commit as. Left empty, they commit as the token's GitHub account (its noreply email).
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# Optional: Exec mode (Linear tickets). A personal API key from Linear → Settings → Security & access.
LINEAR_API_KEY=

# Optional: nameservers asked before your machine's, space-separated. E.g. a VPN's internal DNS, so agents
# reach private endpoints that public DNS resolves to addresses that refuse you.
# DNS_SERVERS=10.0.2.4

# Optional: another port if 4747 is taken (a native Concierge uses 4747 too: run one or the other).
# CONCIERGE_PORT=4747

# Only if the dashboard is unreachable on Docker Desktop: listen on every interface. Anyone who can reach the
# port can start agent runs, so keep it on a trusted machine.
# CONCIERGE_HOST=0.0.0.0
