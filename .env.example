# Copy to .env and fill in. No tokens go here: GitHub, the agents (Claude, OpenAI…), Linear and Tailscale are signed in
# from the app's onboarding, and kept in its config folder (secrets.json, readable only by you).

# Optional: the folder that holds your clones (one parent for all repos you want reviewed), mounted at the same path.
# Empty: Concierge clones what it needs into its own folder, ~/.local/state/concierge/codebases.
CODE_DIR=

# Your user and group id, so files agents write in your repos stay yours. `id -u` and `id -g`.
HOST_UID=501
HOST_GID=20

# Optional: who the agents commit as. Left empty, they commit as the GitHub account you sign in with (its noreply email).
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# Optional: nameservers asked before your machine's, space-separated. E.g. a VPN's internal DNS, so agents
# reach private endpoints that public DNS resolves to addresses that refuse you.
# DNS_SERVERS=10.0.2.4

# Optional: another port if 4747 is taken (a native Concierge uses 4747 too: run one or the other).
# CONCIERGE_PORT=4747

# Only if the dashboard is unreachable on Docker Desktop: listen on every interface. Anyone who can reach the
# port can start agent runs, so keep it on a trusted machine.
# CONCIERGE_HOST=0.0.0.0
