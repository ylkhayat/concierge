#!/usr/bin/env bash
# Start a command with secrets from 1Password in its environment, and nowhere else: not on disk, not in your shell or
# its history, not in any other process. The secrets are op:// references (NAME=op://vault/item/field, one per line)
# in ~/.config/concierge/secrets/<name>.env (or ~/.config/review-deck/…, from before the rename), which syncs between your machines and holds no secret itself.
#   bin/with-secrets <name> -- <command…>      e.g. as an MCP server's command:
#   claude mcp add --scope user mongodb-prod -- ~/code/concierge/bin/with-secrets mongodb-prod -- npx -y mongodb-mcp-server@1
# A Mac uses `op run` (it also masks a secret that shows up in the output); WSL uses Windows' op.exe, the CLI the
# 1Password app unlocks, which can't start a Linux program itself, so the values go straight into this process.
set -euo pipefail
name=${1:?usage: with-secrets <name> -- <command…>}; shift
[[ ${1:-} == -- ]] && shift
refs=~/.config/concierge/secrets/$name.env; [[ -d ~/.config/review-deck ]] && refs=~/.config/review-deck/secrets/$name.env
[[ -f $refs ]] || { echo "with-secrets: no $refs (op:// references: NAME=op://vault/item/field, one per line)" >&2; exit 1; }
if command -v op.exe >/dev/null 2>&1; then
  # resolved in memory only; each line exported as it is (a connection string's & or ? never reaches the shell as
  # code), read through a pipe, never a temporary file
  vals=$(op.exe inject < "$refs" | tr -d '\r') || { echo "with-secrets: 1Password refused ($name)" >&2; exit 1; }
  while IFS= read -r line; do
    [[ $line =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && export "$line"
  done < <(printf '%s\n' "$vals")
  unset vals line
  exec "$@"
fi
# WITH_SECRETS_INTERACTIVE=1: no masking, so an interactive program (mongosh) keeps its terminal; masking pipes its output
exec op run --env-file="$refs" ${WITH_SECRETS_INTERACTIVE:+--no-masking} -- "$@"
